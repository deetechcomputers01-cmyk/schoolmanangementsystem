generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Prisma Migrate needs a direct (non-pooled) connection — it takes a
  // session-level postgres advisory lock to prevent concurrent migrations,
  // which a PgBouncer/transaction-pooled connection (e.g. Neon's pooled
  // connection string) cannot reliably support, causing deploys to fail
  // with P1002 "timed out trying to acquire a postgres advisory lock".
  // DATABASE_URL_UNPOOLED is already provided by Neon's Vercel integration
  // (same value as POSTGRES_URL_NON_POOLING) — no separate var to create.
  // (Stale advisory lock from an earlier failed deploy was also cleared
  // directly against the database — see chat/memory for that incident.)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  super_admin
  principal
  teacher
  staff
  student
  guardian
}

enum AttendanceStatus {
  present
  absent
  late
  excused
}

enum PaymentMethod {
  cash
  mobile_money
  bank_transfer
  card
}

enum FeeStatus {
  unpaid
  partial
  paid
}

enum StudentStatus {
  active
  graduated
  withdrawn
}

enum PayslipStatus {
  draft
  approved
  paid
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  passwordChangedAt DateTime?
  role         Role
  isActive     Boolean     @default(true)
  staff        Staff?
  guardians    Guardian[]
  student      Student?
  auditLogs    AuditLog[]
  blockedIPs   BlockedIP[]
  createdExams          Exam[]
  announcements         Announcement[]         @relation("AnnouncementAuthor")
  notifications         Notification[]         @relation("UserNotifications")
  sentMessages          Message[]              @relation("SentMessages")
  receivedMessages      Message[]              @relation("ReceivedMessages")
  calendarEvents        CalendarEvent[]        @relation("CalendarEventCreator")
  // Helpdesk
  submittedTickets      SupportTicket[]        @relation("TicketRequester")
  assignedTickets       SupportTicket[]        @relation("TicketAssignee")
  ticketMessages        TicketMessage[]        @relation("TicketMsgFrom")
  // Document Center
  ownedDocuments        SchoolDocument[]       @relation("DocOwner")
  // Backup
  initiatedBackups      BackupRecord[]         @relation("BackupInitiator")
  // Broadcasts
  sentBroadcasts        ParentBroadcast[]      @relation("BroadcastSender")
  // Approvals
  submittedApprovals    ApprovalRequest[]      @relation("ApprovalRequester")
  approvalDecisions     ApprovalStep[]         @relation("ApprovalStepApprover")
  // Scholarships
  approvedScholarships  Scholarship[]          @relation("ScholarshipApprover")
  // Expenses
  recordedExpenses      Expense[]              @relation("ExpenseRecorder")
  // Hostel
  reportedHostelIncidents HostelIncident[]     @relation("HostelIncidentReporter")
  // Canteen
  servedMeals             MealServing[]        @relation("MealServer")
  // Assets
  assetMovements          AssetMovement[]      @relation("AssetMovementActor")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Student {
  id          String       @id @default(cuid())
  admissionNo String       @unique
  firstName   String
  lastName    String
  gender      String
  dateOfBirth DateTime
  address     String
  photoUrl    String?
  classId     String
  class       Class        @relation(fields: [classId], references: [id])
  status      StudentStatus @default(active)
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id])
  // Boarding
  boardingType  String?   // "day" | "boarder"
  boardingHouse String?   // e.g. "Eban House"
  boardingRoom  String?   // e.g. "Room 12A"
  guardians           Guardian[]
  attendance          Attendance[]
  grades              Grade[]
  feeRecords          FeeRecord[]
  examScores          ExamScore[]
  scholarships        Scholarship[]
  allocations         Allocation[]
  hostelIncidents     HostelIncident[]
  mealServings        MealServing[]
  healthRecord        HealthRecord?
  bookCheckouts       BookCheckout[]
  transport           StudentTransport[]
  messages            Message[]
  examAttempts        ExamAttempt[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Guardian {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  relation  String
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id               String    @id @default(cuid())
  staffNo          String    @unique
  firstName        String
  lastName         String
  phone            String
  roleTitle        String
  email            String?
  photoUrl         String?
  documents        Json?
  isTeaching       Boolean      @default(true)
  staffCategory    String       @default("teaching") // "teaching"|"accounts"|"driver"|"caterer"|"nurse"|"security"|"admin"
  notes            String?
  userId           String?      @unique
  user             User?        @relation(fields: [userId], references: [id])
  subjects         Subject[]
  homeroomClasses  Class[]      @relation("ClassTeacher")
  salary           StaffSalary?
  payslips         Payslip[]
  vehicles         Vehicle[]
  visitorLogs      VisitorLog[]
  custodianAssets  Asset[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Class {
  id              String          @id @default(cuid())
  name            String          @unique
  level           String
  isActive        Boolean         @default(true)
  capacity        Int?
  room            String?
  order           Int?
  classTeacherId  String?
  classTeacher    Staff?          @relation("ClassTeacher", fields: [classTeacherId], references: [id])
  students        Student[]
  subjects        Subject[]
  timetable       TimetableSlot[]
  exams           Exam[]
  feeStructures   FeeStructure[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model Subject {
  id        String          @id @default(cuid())
  name      String
  code      String          @unique
  classId   String
  class     Class           @relation(fields: [classId], references: [id])
  staffId   String?
  staff     Staff?          @relation(fields: [staffId], references: [id])
  grades    Grade[]
  timetable TimetableSlot[]
  exams     Exam[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  student   Student          @relation(fields: [studentId], references: [id])
  classId   String
  date      DateTime
  status    AttendanceStatus
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([studentId, date])
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  subjectId String
  subject   Subject  @relation(fields: [subjectId], references: [id])
  term      String
  score     Float
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeeRecord {
  id              String       @id @default(cuid())
  studentId       String
  student         Student      @relation(fields: [studentId], references: [id])
  term            String
  description     String
  amountDue       Decimal      @db.Decimal(10, 2)
  discountApplied Decimal?     @db.Decimal(10, 2)
  scholarshipId   String?
  scholarship     Scholarship? @relation(fields: [scholarshipId], references: [id], onDelete: SetNull)
  status          FeeStatus    @default(unpaid)
  payments        Payment[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

// The standard fee amount a class is expected to pay per term/category —
// set once in Settings, then used to prefill real invoices (FeeRecord)
// instead of every invoice being typed from scratch with no reference
// value. `term` stays a free-text string, matching how FeeRecord.term
// and the rest of the fees module already work (not linked to the Term
// model anywhere else in this schema).
model FeeStructure {
  id        String   @id @default(cuid())
  classId   String
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  term      String
  category  String
  amount    Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, term, category])
}

model Payment {
  id          String        @id @default(cuid())
  feeRecordId String
  feeRecord   FeeRecord     @relation(fields: [feeRecordId], references: [id])
  amount      Decimal       @db.Decimal(10, 2)
  method      PaymentMethod
  reference   String
  paidAt      DateTime      @default(now())
  createdAt   DateTime      @default(now())
}

model TimetableSlot {
  id            String   @id @default(cuid())
  classId       String
  class         Class    @relation(fields: [classId], references: [id])
  subjectId     String
  subject       Subject  @relation(fields: [subjectId], references: [id])
  day           String   // "Monday" | "Tuesday" | ... | "Friday"
  startsAt      String   // "08:00"
  endsAt        String   // "09:00"
  room          String
  recurrence    String   @default("weekly") // "weekly" | "biweekly" | "one_time"
  effectiveDate String?  // YYYY-MM-DD; required when recurrence = "one_time"
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BlockedIP {
  id          String    @id @default(cuid())
  ip          String    @unique
  reason      String?
  blockedById String
  blockedBy   User      @relation(fields: [blockedById], references: [id])
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String
  audience    String[]  // role names; empty = everyone
  isPinned    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  authorId    String
  author      User      @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "fee_reminder" | "attendance_alert" | "exam_result" | "staff_announcement" | "system"
  title     String
  body      String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model SchoolSettings {
  id           String   @id @default("singleton")
  name         String   @default("ScholarSphere Academy")
  address      String   @default("")
  motto        String   @default("")
  phone        String   @default("")
  email        String   @default("")
  logoUrl      String?
  letterheadUrl String?
  reportFooter String   @default("")
  timezone     String   @default("Africa/Accra")
  gradingScale Json?
  extra        Json?
  updatedAt    DateTime @updatedAt
}

model CalendarEvent {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  category    String   @default("academic")
  date        DateTime
  time        String?
  endTime     String?
  location    String?
  audience    String?
  approved    Boolean  @default(false)
  createdById String
  createdBy   User     @relation("CalendarEventCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Exam {
  id          String          @id @default(cuid())
  title       String
  termId      String?
  term        Term?           @relation(fields: [termId], references: [id])
  subjectId   String
  subject     Subject         @relation(fields: [subjectId], references: [id])
  classId     String
  class       Class           @relation(fields: [classId], references: [id])
  scheduledAt DateTime
  maxScore    Float           @default(100)
  isOnline    Boolean         @default(false)
  duration    Int?            // minutes; null = untimed
  scores      ExamScore[]
  questions   ExamQuestion[]
  attempts    ExamAttempt[]
  createdById String
  createdBy   User            @relation(fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model ExamScore {
  id        String   @id @default(cuid())
  examId    String
  exam      Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  score     Float
  remarks   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examId, studentId])
}

model ExamQuestion {
  id           String          @id @default(cuid())
  examId       String
  exam         Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  order        Int
  text         String
  type         String          @default("mcq") // mcq | short_answer
  options      Json?           // ["A", "B", "C", "D"] for MCQ
  correctAnswer String?        // "A" for MCQ, or model answer text
  marks        Float           @default(1)
  answers      StudentAnswer[]
  createdAt    DateTime        @default(now())
}

model ExamAttempt {
  id          String          @id @default(cuid())
  examId      String
  exam        Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id])
  startedAt   DateTime        @default(now())
  submittedAt DateTime?
  score       Float?          // auto-calculated on submit for MCQ
  answers     StudentAnswer[]

  @@unique([examId, studentId])
}

model StudentAnswer {
  id          String       @id @default(cuid())
  attemptId   String
  attempt     ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId  String
  question    ExamQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer      String?
  isCorrect   Boolean?
  marksAwarded Float?
  createdAt   DateTime     @default(now())

  @@unique([attemptId, questionId])
}

model AcademicYear {
  id           String        @id @default(cuid())
  name         String        @unique  // e.g. "2025/2026"
  startDate    DateTime
  endDate      DateTime
  isCurrent    Boolean       @default(false)
  terms        Term[]
  scholarships Scholarship[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Term {
  id             String       @id @default(cuid())
  name           String
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)
  exams          Exam[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([academicYearId, name])
}

// ── Payroll ───────────────────────────────────────────────────────────────────

model StaffSalary {
  id            String    @id @default(cuid())
  staffId       String    @unique
  staff         Staff     @relation(fields: [staffId], references: [id])
  basicSalary   Decimal   @db.Decimal(10, 2)
  allowances    Decimal   @db.Decimal(10, 2) @default(0)
  deductions    Decimal   @db.Decimal(10, 2) @default(0)
  effectiveFrom DateTime
  payslips      Payslip[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Payslip {
  id          String        @id @default(cuid())
  staffId     String
  staff       Staff         @relation(fields: [staffId], references: [id])
  salaryId    String
  salary      StaffSalary   @relation(fields: [salaryId], references: [id])
  month       String        // "2026-06"
  basicSalary Decimal       @db.Decimal(10, 2)
  allowances  Decimal       @db.Decimal(10, 2)
  deductions  Decimal       @db.Decimal(10, 2)
  netPay      Decimal       @db.Decimal(10, 2)
  status      PayslipStatus @default(draft)
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([staffId, month])
}

// ── Health Records ────────────────────────────────────────────────────────────

model HealthRecord {
  id               String        @id @default(cuid())
  studentId        String        @unique
  student          Student       @relation(fields: [studentId], references: [id])
  bloodGroup       String?
  allergies        String?
  conditions       String?
  emergencyContact String?
  emergencyPhone   String?
  visits           SickVisit[]
  vaccinations     Vaccination[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model SickVisit {
  id             String       @id @default(cuid())
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
  date           DateTime     @default(now())
  complaint      String
  treatment      String?
  notes          String?
  status         String       @default("waiting")   // waiting | in_consultation | medication_due | completed
  triage         String       @default("routine")   // routine | urgent | emergency | scheduled
  vitalsTemp     String?
  vitalsBp       String?
  createdAt      DateTime     @default(now())
}

model Vaccination {
  id             String       @id @default(cuid())
  healthRecordId String
  healthRecord   HealthRecord @relation(fields: [healthRecordId], references: [id], onDelete: Cascade)
  vaccineName    String
  date           DateTime
  nextDue        DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
}

// ── Library ───────────────────────────────────────────────────────────────────

model Book {
  id            String         @id @default(cuid())
  title         String
  author        String
  isbn          String?        @unique
  category      String
  quantity      Int            @default(1)
  available     Int            @default(1)
  shelfLocation String?
  checkouts     BookCheckout[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model BookCheckout {
  id           String    @id @default(cuid())
  bookId       String
  book         Book      @relation(fields: [bookId], references: [id])
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  checkedOutAt DateTime  @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  metadata  Json?
  createdAt DateTime @default(now())
}

// ── Transport ─────────────────────────────────────────────────────────────────

model Vehicle {
  id                String          @id @default(cuid())
  regNo             String          @unique
  make              String
  capacity          Int
  type              String          // "bus" | "van" | "minibus"
  driverId          String?
  driver            Staff?          @relation(fields: [driverId], references: [id])
  routes            TransportRoute[]
  latitude          Float?
  longitude         Float?
  heading           Float?
  speed             Float?
  locationUpdatedAt DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model TransportRoute {
  id              String             @id @default(cuid())
  name            String
  vehicleId       String?
  vehicle         Vehicle?           @relation(fields: [vehicleId], references: [id])
  stops           String[]
  morningPickup   String             // "06:30"
  afternoonDrop   String             // "15:30"
  students        StudentTransport[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model StudentTransport {
  id        String         @id @default(cuid())
  studentId String
  student   Student        @relation(fields: [studentId], references: [id])
  routeId   String
  route     TransportRoute @relation(fields: [routeId], references: [id])
  createdAt DateTime       @default(now())

  @@unique([studentId, routeId])
}

// ── Security / Visitor Log ─────────────────────────────────────────────────────

model VisitorLog {
  id          String    @id @default(cuid())
  visitorName String
  phone       String?
  purpose     String
  hostName    String
  entryTime   DateTime  @default(now())
  exitTime    DateTime?
  badgeNo     String?
  gateStaffId String?
  gateStaff   Staff?    @relation(fields: [gateStaffId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Meal Menu ─────────────────────────────────────────────────────────────────

model MealMenu {
  id       String   @id @default(cuid())
  weekOf   String   // ISO date of the Monday for that week, e.g. "2026-06-30"
  day      String   // "Monday" | "Tuesday" | ... | "Friday"
  mealType String   // "Breakfast" | "Lunch" | "Dinner"
  items    String[] // list of dishes
  servings MealServing[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([weekOf, day, mealType])
}

model MealServing {
  id           String   @id @default(cuid())
  menuId       String
  menu         MealMenu @relation(fields: [menuId], references: [id], onDelete: Cascade)
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id])
  servedAt     DateTime @default(now())
  servedById   String
  servedBy     User     @relation("MealServer", fields: [servedById], references: [id])

  @@unique([menuId, studentId])
}

// ── Helpdesk / Support Tickets ────────────────────────────────────────────────

model SupportTicket {
  id          String          @id @default(cuid())
  ticketNo    String          @unique  // e.g. "#1001"
  subject     String
  description String
  status      String          @default("open")    // open | in_progress | resolved | closed | escalated
  priority    String          @default("medium")  // urgent | high | medium | low
  queue       String          @default("general") // parent | teacher | it | finance | maintenance | general
  requesterId String
  requester   User            @relation("TicketRequester",  fields: [requesterId], references: [id])
  assigneeId  String?
  assignee    User?           @relation("TicketAssignee",   fields: [assigneeId],  references: [id])
  messages    TicketMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  fromId     String
  from       User          @relation("TicketMsgFrom", fields: [fromId], references: [id])
  body       String
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())
}

// ── Document Center ───────────────────────────────────────────────────────────

model SchoolDocument {
  id          String    @id @default(cuid())
  name        String
  category    String    // student-records | staff-files | policies | admissions | finance | exams | circulars | forms | archived
  fileUrl     String    @default("")
  fileSize    String    @default("")
  fileType    String    @default("pdf")
  visibility  String    @default("internal") // private | internal | public
  status      String    @default("active")   // active | pending_review | archived | restricted
  ownerId     String
  owner       User      @relation("DocOwner", fields: [ownerId], references: [id])
  classDept   String?
  needsSign   Boolean   @default(false)
  isTemplate  Boolean   @default(false)
  sharedWith  String[]
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Backup Records ────────────────────────────────────────────────────────────

model BackupRecord {
  id          String    @id @default(cuid())
  name        String
  backupType  String    @default("full")     // full | incremental | db | files | config
  sizeBytes   BigInt    @default(0)
  target      String    @default("s3")       // s3 | drive | nas | local
  status      String    @default("pending")  // pending | running | healthy | failed
  duration    Int?      // seconds
  encryption  String    @default("AES-256")
  checksum    String?
  expiresAt   DateTime?
  initiatedBy String?
  initiator   User?     @relation("BackupInitiator", fields: [initiatedBy], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Parent Broadcast Messages ─────────────────────────────────────────────────

model ParentBroadcast {
  id          String    @id @default(cuid())
  subject     String
  body        String
  audience    String    @default("all")    // all | defaulters | boarding | pta | class:<classId>
  channels    String[]                     // sms | whatsapp | email
  status      String    @default("draft")  // draft | pending | delivered | failed | scheduled
  scheduledAt DateTime?
  sentAt      DateTime?
  delivered   Int       @default(0)
  failed      Int       @default(0)
  pending     Int       @default(0)
  isConsent   Boolean   @default(false)
  sentById    String
  sentBy      User      @relation("BroadcastSender", fields: [sentById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ── Messages ──────────────────────────────────────────────────────────────────

model Message {
  id         String   @id @default(cuid())
  content    String
  senderId   String
  sender     User     @relation("SentMessages",     fields: [senderId],   references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  studentId  String?
  student    Student? @relation(fields: [studentId], references: [id])
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

// ── Approvals ──────────────────────────────────────────────────────────────────

enum ApprovalStatus {
  pending
  approved
  rejected
}

enum ApprovalDecision {
  pending
  approved
  rejected
}

model ApprovalRequest {
  id               String           @id @default(cuid())
  type             String           // "expense" | "scholarship" | "procurement" etc.
  title            String
  requesterId      String
  requester        User             @relation("ApprovalRequester", fields: [requesterId], references: [id])
  payload          Json
  status           ApprovalStatus   @default(pending)
  currentStepIndex Int              @default(0)
  steps            ApprovalStep[]
  expense          Expense?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model ApprovalStep {
  id           String           @id @default(cuid())
  requestId    String
  request      ApprovalRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  order        Int
  approverRole String?          // role-based approval, e.g. "principal"
  approverId   String?          // or a specific user
  approver     User?            @relation("ApprovalStepApprover", fields: [approverId], references: [id])
  decision     ApprovalDecision @default(pending)
  reason       String?
  decidedAt    DateTime?
  createdAt    DateTime         @default(now())

  @@unique([requestId, order])
}

// ── Scholarships ────────────────────────────────────────────────────────────────

enum ScholarshipType {
  percent
  fixed
}

enum ScholarshipStatus {
  active
  expired
  revoked
}

model Scholarship {
  id             String            @id @default(cuid())
  studentId      String
  student        Student           @relation(fields: [studentId], references: [id])
  type           ScholarshipType
  value          Float             // percent (0-100) if type=percent, else a fixed GHS amount
  reason         String?
  academicYearId String?
  academicYear   AcademicYear?     @relation(fields: [academicYearId], references: [id])
  status         ScholarshipStatus @default(active)
  approvedById   String?
  approvedBy     User?             @relation("ScholarshipApprover", fields: [approvedById], references: [id])
  feeRecords     FeeRecord[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// ── Expenses ────────────────────────────────────────────────────────────────────

enum ExpenseStatus {
  pending
  approved
  rejected
}

model Expense {
  id                 String           @id @default(cuid())
  category           String
  description        String
  amount             Decimal          @db.Decimal(10, 2)
  vendor             String?
  date               DateTime
  status             ExpenseStatus    @default(pending)
  recordedById       String
  recordedBy         User             @relation("ExpenseRecorder", fields: [recordedById], references: [id])
  approvalRequestId  String?          @unique
  approvalRequest    ApprovalRequest? @relation(fields: [approvalRequestId], references: [id])
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

// ── Hostel ──────────────────────────────────────────────────────────────────────

model Hostel {
  id        String   @id @default(cuid())
  name      String   @unique
  rooms     Room[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Room {
  id          String           @id @default(cuid())
  hostelId    String
  hostel      Hostel           @relation(fields: [hostelId], references: [id])
  name        String
  capacity    Int
  allocations Allocation[]
  incidents   HostelIncident[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([hostelId, name])
}

model Allocation {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id])
  roomId    String
  room      Room      @relation(fields: [roomId], references: [id])
  bedNumber Int
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model HostelIncident {
  id           String   @id @default(cuid())
  studentId    String?
  student      Student? @relation(fields: [studentId], references: [id])
  roomId       String?
  room         Room?    @relation(fields: [roomId], references: [id])
  description  String
  reportedById String
  reportedBy   User     @relation("HostelIncidentReporter", fields: [reportedById], references: [id])
  createdAt    DateTime @default(now())
}

// ── Assets ──────────────────────────────────────────────────────────────────────

enum AssetStatus {
  active
  maintenance
  disposed
  low_stock
}

model Asset {
  id          String          @id @default(cuid())
  tag         String          @unique
  name        String
  category    String          // "ICT Equipment" | "Furniture" | "Lab Equipment" | "Library" | "Sports" | "Kitchen"
  status      AssetStatus     @default(active)
  location    String?
  custodianId String?
  custodian   Staff?          @relation(fields: [custodianId], references: [id])
  quantity    Int             @default(1)
  value       Decimal?        @db.Decimal(10, 2)
  imageUrl    String?
  movements   AssetMovement[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model AssetMovement {
  id        String   @id @default(cuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  type      String   // "issue" | "receive" | "transfer" | "adjustment"
  quantity  Int
  note      String?
  actedById String
  actedBy   User     @relation("AssetMovementActor", fields: [actedById], references: [id])
  createdAt DateTime @default(now())
}
