# App queries run through this at runtime. On Neon (or any pooled Postgres
# host), this should be the POOLED connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/school_ms?schema=public"
# Prisma Migrate uses this instead of DATABASE_URL. On Neon (or any pooled
# Postgres host), this must be the DIRECT/unpooled connection string — the
# advisory lock migrations take to prevent concurrent deploys doesn't work
# reliably through a transaction pooler (PgBouncer). Neon's Vercel
# integration already provides this exact variable (same value as
# POSTGRES_URL_NON_POOLING) — no separate var needs to be created there.
# Locally these can be identical since there's no pooler.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5432/school_ms?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
