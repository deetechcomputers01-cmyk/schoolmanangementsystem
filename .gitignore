build/
dist/

# environment files — NEVER commit secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# keep example so contributors know what vars are needed
!.env.example

# database
prisma/*.db
prisma/*.db-journal

# full-database backup dumps (contain password hashes + all PII — never commit)
backend-data/

