{
  "name": "scholarsphere-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev":          "npm run dev --prefix frontend",
    "build":        "npm run build --prefix frontend",
    "start":        "npm run start --prefix frontend",
    "backend:dev":  "npm run dev --prefix backend",
    "backend:build":"npm run build --prefix backend",
    "backend:start":"npm run start --prefix backend",
    "install:all":  "npm install --prefix frontend && npm install --prefix backend",
    "db:migrate":   "npm run db:migrate --prefix frontend",
    "db:seed":      "npm run db:seed --prefix frontend"
  },
  "workspaces": ["frontend", "backend"]
}
